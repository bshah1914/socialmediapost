# --- NVIDIA NIM (the agents' brain) -----------------------------------------
# Free key: https://build.nvidia.com  -> any model -> "Get API Key"
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Tried in order when the primary is overloaded or retired (NVIDIA's free catalogue changes)
NVIDIA_FALLBACK_MODELS=openai/gpt-oss-20b
NVIDIA_TIMEOUT_SECONDS=120

# --- Schedule ----------------------------------------------------------------
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=5
# Only stories published in the last N hours are considered
SCAN_MAX_AGE_HOURS=12
TIMEZONE=Asia/Kolkata

# --- Agents' bars ------------------------------------------------------------
# Scanner score (0-10) a story needs to reach the reviewer
SCAN_MIN_SCORE=6
# Reviewer score (0-10) a story needs to be posted
REVIEW_MIN_SCORE=8

# --- Instagram ----------------------------------------------------------------
# dry_run: render the card + caption into data/outbox only (start here)
# instagram: upload with instagrapi (unofficial; run `flask --app run ig-login` once first)
IG_DELIVERY=dry_run
IG_USERNAME=
IG_PASSWORD=
IG_TOTP_SECRET=
IG_HANDLE=yourtechpage
POSTS_PER_DAY=6
MIN_POST_GAP_MINUTES=90
# After Instagram answers "We restrict certain activity"
IG_RESTRICT_PAUSE_HOURS=24
IG_WARNED_PAUSE_MINUTES=10

# --- Web ----------------------------------------------------------------------
# When set, POST endpoints need header "X-Admin-Token: <value>"
ADMIN_TOKEN=
